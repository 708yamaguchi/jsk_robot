<!-- https://github.com/jsk-ros-pkg/jsk_recognition/blob/master/doc/jsk_perception/nodes/point_pose_extractor.md -->
<!-- https://github.com/takayuki5168/jsk_demos/blob/microwave-devel/microwave_pr2_201710/launch/detect_microwave.launch -->

<launch>
  <!-- Nodelet -->
  <arg name="manager" default="marker_track_nodelet_manager" />
  <!-- Recognition -->
  <arg name="image" default="/l515_head/color/quater/image_raw" />
  <arg name="camera_info" default="/l515_head/color/quater/camera_info"/>
  <arg name="template_filename" default="$(find jsk_fetch_startup)/data/charger_marker_170mmx258mm.png" />
  <!-- Visualize -->
  <arg name="gui" default="false" />

  <!-- Launch nodelet -->
  <node pkg="nodelet" type="nodelet" name="$(arg manager)" args="manager" output="screen" />

  <!-- Using marker -->
  <!-- <!-\- Extract SIFT key points -\-> -->
  <!-- <node name="imagesift" pkg="nodelet" type="nodelet" -->
  <!--       args="load imagesift/ImageSift $(arg manager)" -->
  <!--       respawn="true" output="screen"> -->
  <!--   <remap from="image" to="$(arg image)"/> -->
  <!--   <remap from="camera_info" to="$(arg camera_info)" /> -->
  <!-- </node> -->

  <!-- <!-\- Calcute object pose compared to template. -\-> -->
  <!-- <node name="point_pose_extractor" pkg="jsk_perception" type="point_pose_extractor" -->
  <!--       respawn="true" output="screen"> -->
  <!--   <param name="template_filename" value="$(arg template_filename)"/> -->
  <!--   <!-\- Parameter tunings -\-> -->
  <!--   <!-\- <param name="reprojection_threshold" value="3.0" />  <!-\\- TODO cv::findHomography ransacReprojThreshold 許容される誤差の最大値 1から10が妥当10 3.0 -\\-> -\-> -->
  <!--   <!-\- <param name="distanceratio_threshold" value="0.6" /> <!-\\- TODO 0.6 0.49 -\\-> -\-> -->
  <!--   <!-\- <param name="relative_pose" value="0 0 0 0 0 0 1" />    <!-\\- TODO quaternion expression -\\-> -\-> -->
  <!--   <param name="object_height" value="0.258" /> -->
  <!--   <param name="object_width" value="0.170" /> -->
  <!--   <param name="viewer_window" value="false" /> -->
  <!-- </node> -->

  <!-- <!-\- To always visualize /point_pose_extractor/debug_image -\-> -->
  <!-- <node pkg="rostopic" type="rostopic" name="echo_object_detection" -->
  <!--       args="echo /ObjectDetection -\-noarr" /> -->

  <!-- <!-\- Publish bounding box of wireless charger -\-> -->
  <!-- <node pkg="jsk_fetch_startup" name="charger_boundingbox" type="charger-boundingbox.l" -->
  <!--       args="&quot;(main)&quot;"/> -->  

  <!-- color recognition -->
  <node name="resize_cloud" pkg="nodelet" type="nodelet"
        args="standalone jsk_pcl/ResizePointsPublisher" output="screen">
    <remap from="~input" to="/l515_head/depth/color/points" />
    <remap from="~output" to="/l515_head/depth/color/quater/points" />
    <rosparam>
      step_x: 4
      step_y: 4
    </rosparam>
  </node>
  <include file="$(find jsk_pcl_ros)/launch/hsi_color_filter.launch">
    <!-- <arg name="INPUT" value="points" /> -->
    <!-- <arg name="DEFAULT_NAMESPACE" value="/head_camera/depth_registered/quater/throttled" /> -->
    <arg name="INPUT" value="points" />
    <arg name="DEFAULT_NAMESPACE" value="/l515_head/depth/color/quater" />
    <arg name="h_max" default="111" />
    <arg name="h_min" default="75" />
    <arg name="s_max" default="255" />
    <arg name="s_min" default="45" />
    <arg name="i_max" default="255" />
    <arg name="i_min" default="57" />
  </include>

  <node if="$(arg gui)" name="qi_track_view" pkg="nodelet" type="nodelet" output="screen"
        args="load image_view/image $(arg manager)" >
    <remap from="image" to="point_pose_extractor/debug_image" />
  </node>

</launch>
